
-- OK: Everything is fine
-- A name is taken from the IMPORTS clause that lists it, even if an
-- earlier clause's module also defines (but does not export) that name.

ModuleImportsRight1 { iso org(3) dod(6) internet(1) private(4) enterprise(1)
	spelio(9363) software(1) asn1c(5) test(1) 166 1 }
	DEFINITIONS ::=
BEGIN
	EXPORTS Foo;
	Foo ::= INTEGER
	Bar ::= INTEGER
END

ModuleImportsRight2 { iso org(3) dod(6) internet(1) private(4) enterprise(1)
	spelio(9363) software(1) asn1c(5) test(1) 166 2 }
	DEFINITIONS ::=
BEGIN
	Bar ::= BOOLEAN
END

ModuleImportsRight3 { iso org(3) dod(6) internet(1) private(4) enterprise(1)
	spelio(9363) software(1) asn1c(5) test(1) 166 3 }
	DEFINITIONS ::=
BEGIN
	IMPORTS Foo FROM ModuleImportsRight1 Bar FROM ModuleImportsRight2;
	X ::= SEQUENCE { a Foo, b Bar }
END
